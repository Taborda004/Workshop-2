# ==============================================================================
# WORKSHOP 2 — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and adjust credentials as needed.
# ==============================================================================

# ── Airflow Configuration ─────────────────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW__CORE__FERNET_KEY=your_generated_fernet_key_here

# ── MySQL Root Credentials ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=your_root_password_here

# ── MySQL Source DB (Grammy Awards Operational Source) ────────────────────────
MYSQL_SOURCE_HOST=mysql-source
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_DB=grammy_source
MYSQL_SOURCE_USER=etl_user
MYSQL_SOURCE_PASSWORD=your_etl_password_here

# ── MySQL Data Warehouse (Target music_dw) ────────────────────────────────────
MYSQL_DW_HOST=mysql-dw
MYSQL_DW_PORT=3306
MYSQL_DW_DB=music_dw
MYSQL_DW_USER=dw_user
MYSQL_DW_PASSWORD=your_dw_password_here

# ── Pipeline Paths ────────────────────────────────────────────────────────────
SPOTIFY_CSV_PATH=/opt/airflow/data/spotify_dataset.csv
AIRFLOW_WORK_DIR=/opt/airflow/data/work
AIRFLOW_OUTPUT_DIR=/opt/airflow/data/output

# ── Container Additional Python Packages ──────────────────────────────────────
_PIP_ADDITIONAL_REQUIREMENTS=great-expectations==1.3.10 pandas==2.2.3 sqlalchemy==2.0.36 pymysql==1.1.1 cryptography==43.0.3 pyarrow==17.0.0
